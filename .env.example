# ─── AltSignal 100 environment ─────────────────────────────────────────────
# Copy to .env.local. Nothing here is required for demo mode.

# demo  = deterministic synthetic fixtures for every source (default, no credentials)
# live  = use live adapters where credentials/access exist; other sources show "unavailable"
ALTSIGNAL_MODE=demo

# SQLite file used for local development (libSQL driver).
DATABASE_URL=file:./data/altsignal.db

# Comma-separated provider ids to disable at runtime (e.g. "hackernews,github").
# Disabled providers are shown as "unavailable" and excluded from scores.
ALTSIGNAL_DISABLED_PROVIDERS=

# Protects POST /api/admin/refresh. Leave empty to disable the endpoint entirely.
ADMIN_TOKEN=

# Polite contact string sent as User-Agent to Wikimedia / SEC per their API policies.
ALTSIGNAL_CONTACT=altsignal-100 research prototype (you@example.com)

# ─── Optional live providers ───────────────────────────────────────────────
# Reddit: create a "script" app at https://www.reddit.com/prefs/apps (OAuth, app-only).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# GitHub: optional; raises the REST rate limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# Universe / market data: a licensed provider is needed for live market caps and prices.
# Financial Modeling Prep adapter (https://site.financialmodelingprep.com/developer/docs).
FMP_API_KEY=

# ─── Advanced ──────────────────────────────────────────────────────────────
# Alternative universe snapshot (JSON with the same schema as the bundled file).
ALTSIGNAL_UNIVERSE_FILE=
# Salt for one-way hashing of author handles in live mode. Set a long random value.
ALTSIGNAL_AUTHOR_SALT=
# Demo only: strength of the documented, deliberately planted price link (0 removes it).
ALTSIGNAL_PLANTED_COUPLING=0.35
